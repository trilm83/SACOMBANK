    <bpmn:sequenceFlow id="Flow_to_catch_result" sourceRef="Gateway_wait_response" targetRef="Event_receive_result" />
    <bpmn:sequenceFlow id="Flow_to_update" sourceRef="Event_catch_update_req" targetRef="Activity_update_req" />
