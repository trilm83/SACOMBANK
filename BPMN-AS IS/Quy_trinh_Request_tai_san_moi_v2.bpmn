      <bpmn:incoming>Flow_confirm_to_merge_inv</bpmn:incoming>
      <bpmn:incoming>Flow_restock_to_merge_inv</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_inv_to_search</bpmn:outgoing>
