    <bpmn:task id="Activity_09uqqr2" name="Tìm kiếm và kiểm tra tồn kho">
      <bpmn:incoming>Flow_merge_inv_to_search</bpmn:incoming>
      <bpmn:outgoing>Flow_1c27tmx</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_0jkkbgc" name="Còn hàng?">
