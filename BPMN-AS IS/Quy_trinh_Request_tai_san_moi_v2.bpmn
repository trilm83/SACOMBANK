    </bpmn:exclusiveGateway>

    <!-- === Nhánh "Không còn hàng" === -->
    <bpmn:parallelGateway id="Gateway_1b0mmh6">
      <bpmn:incoming>Flow_09m7ubi</bpmn:incoming>
      <bpmn:outgoing>Flow_1vntlvq</bpmn:outgoing>
