  <bpmn:process id="Process_0d65nqw" isExecutable="false">

    <!-- FIX #5: Thêm tên cho Message Start Event -->
    <bpmn:startEvent id="Event_1fc3e7u" name="Nhận request từ Phòng/Ban">
      <bpmn:outgoing>Flow_1rd2ezt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0kzevka" />
    </bpmn:startEvent>

    <!-- FIX #1: Thêm XOR Merge trước Task Xác minh (gom Start Event + loop-back) -->
    <bpmn:exclusiveGateway id="Gateway_merge_verify">
      <bpmn:incoming>Flow_1rd2ezt</bpmn:incoming>
      <bpmn:incoming>Flow_msg_updated_to_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_merge_to_verify</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Activity_0wum9fc" name="Xác minh tính hợp lệ của yêu cầu">
      <bpmn:incoming>Flow_merge_to_verify</bpmn:incoming>
      <bpmn:outgoing>Flow_1sagrxm</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_0cu5dp2" name="Hợp lệ?">
      <bpmn:incoming>Flow_1sagrxm</bpmn:incoming>
      <bpmn:outgoing>Flow_1juqwz6</bpmn:outgoing>
      <bpmn:outgoing>Flow_15jfbob</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- FIX #3: Đổi userTask → sendTask (gửi yêu cầu bổ sung về Pool 1) -->
    <bpmn:sendTask id="Activity_0imvodb" name="Yêu cầu Phòng/Ban bổ sung thông tin">
      <bpmn:incoming>Flow_1juqwz6</bpmn:incoming>
      <bpmn:outgoing>Flow_to_wait_update</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- FIX #1: Chờ Phòng/Ban gửi lại bản cập nhật, rồi loop về xác minh -->
    <bpmn:intermediateCatchEvent id="Event_msg_updated" name="Nhận request đã cập nhật">
      <bpmn:incoming>Flow_to_wait_update</bpmn:incoming>
      <bpmn:outgoing>Flow_msg_updated_to_merge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_updated" />
    </bpmn:intermediateCatchEvent>

    <!-- FIX #2: Thêm khả năng từ chối — xử lý qua Gateway "Hợp lệ?" thêm nhánh -->
    <!-- Giữ nguyên 2 nhánh ở Gateway_0cu5dp2: Không → gửi yêu cầu bổ sung (loop),
         thêm nhánh thứ 3 "Từ chối" trực tiếp -->

    <bpmn:task id="Activity_1he9il5" name="Xác nhận phiếu request">
      <bpmn:incoming>Flow_15jfbob</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_to_merge_inv</bpmn:outgoing>
    </bpmn:task>

    <!-- FIX #4: Thêm XOR Merge trước Tìm kiếm tồn kho (gom "Có hợp lệ" + "Hàng đã nhập kho") -->
