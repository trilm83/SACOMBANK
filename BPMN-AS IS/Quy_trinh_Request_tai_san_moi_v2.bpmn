  <bpmn:process id="Process_0ddhdbv" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1i9m583" name="Bắt đầu">
      <bpmn:outgoing>Flow_0akouhh</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_1kx4mtd" name="Tổng hợp nhu cầu theo tuần / quý">
      <bpmn:incoming>Flow_0akouhh</bpmn:incoming>
      <bpmn:outgoing>Flow_1ptvlpd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Activity_1k5gj8g" name="Truy cập SmartIT và tạo request">
      <bpmn:incoming>Flow_1ptvlpd</bpmn:incoming>
      <bpmn:outgoing>Flow_to_wait</bpmn:outgoing>
    </bpmn:sendTask>

    <!-- FIX #6 & #3: Phòng/Ban chờ phản hồi, có thể được yêu cầu cập nhật -->
    <bpmn:eventBasedGateway id="Gateway_wait_response" name="Chờ phản hồi">
      <bpmn:incoming>Flow_to_wait</bpmn:incoming>
      <bpmn:incoming>Flow_resend_to_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_to_catch_update</bpmn:outgoing>
      <bpmn:outgoing>Flow_to_catch_result</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_catch_update_req" name="Nhận yêu cầu bổ sung">
      <bpmn:incoming>Flow_to_catch_update</bpmn:incoming>
      <bpmn:outgoing>Flow_to_update</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_catch_update" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Activity_update_req" name="Cập nhật request theo yêu cầu">
      <bpmn:incoming>Flow_to_update</bpmn:incoming>
      <bpmn:outgoing>Flow_to_resend</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Activity_resend" name="Gửi lại request đã cập nhật">
      <bpmn:incoming>Flow_to_resend</bpmn:incoming>
      <bpmn:outgoing>Flow_resend_to_wait</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_receive_result" name="Nhận kết quả">
      <bpmn:incoming>Flow_to_catch_result</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end_pool1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_receive_result" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_1mb0krl" name="Kết thúc">
      <bpmn:incoming>Flow_to_end_pool1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_0akouhh" sourceRef="StartEvent_1i9m583" targetRef="Activity_1kx4mtd" />
